# Copy to .env and adjust for your environment
DEBUG=True
SECRET_KEY=django-insecure-coffee-bliss-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_NAME=Coffee Bliss
SITE_URL=http://127.0.0.1:8000
# Optional hero video URL. Defaults to /static/video/hero-coffee.mp4 when that file exists.
HERO_VIDEO_URL=
LOG_LEVEL=INFO
# Optional error monitoring
SENTRY_DSN=
# Optional scale add-ons
REDIS_URL=
CELERY_BROKER_URL=
TWO_FACTOR_ENABLED=False
# Opt in to demo catalogue/users/orders (never enable in production)
SEED_DEMO_DATA=False

# Create/repair only the documented demo logins on a throwaway deployment
BOOTSTRAP_DEMO_ACCOUNTS=False

# Optional bootstrap administrator (created during deploy when both are set)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Database (defaults to SQLite). Example Postgres URL:
# DATABASE_URL=postgres://user:password@localhost:5432/coffeebliss
# DATABASE_URL=sqlite:///db.sqlite3

# Business rules
CURRENCY_SYMBOL=₦
CURRENCY_CODE=NGN
TAX_RATE=0.075
DELIVERY_FEE=1500.00
FREE_DELIVERY_THRESHOLD=25000.00
LOYALTY_POINTS_PER_DOLLAR=1
LOYALTY_POINT_VALUE=0.05

# Email (console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@coffeebliss.test

# Realtime kitchen display (Django Channels)
# Defaults to an in-memory layer (single process). For multi-process prod use Redis:
# CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
# CHANNEL_LAYER_HOSTS=redis://127.0.0.1:6379/0
KDS_ENABLED=True

# Stripe payments. Leave the secret key blank to run the simulated gateway.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ngn

# Paystack payments (recommended for NGN). Leave the secret key blank to disable.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# AI assistant (Bean). With no API key the widget uses an offline,
# database-backed responder, so every setting below is optional.
AI_ENABLED=True
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=25
AI_MAX_TOKENS=450
AI_TEMPERATURE=0.4
AI_MAX_HISTORY=12
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MINUTES=10
