# Copy to .env and adjust for your environment
DEBUG=True
SECRET_KEY=django-insecure-coffee-bliss-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_NAME=Coffee Bliss

# Database (defaults to SQLite). Example Postgres URL:
# DATABASE_URL=postgres://user:password@localhost:5432/coffeebliss
# DATABASE_URL=sqlite:///db.sqlite3

# Business rules
TAX_RATE=0.08
DELIVERY_FEE=2.50
FREE_DELIVERY_THRESHOLD=35.00
LOYALTY_POINTS_PER_DOLLAR=10
LOYALTY_POINT_VALUE=0.01

# Email (console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@coffeebliss.test

# Realtime kitchen display (Django Channels)
# Defaults to an in-memory layer (single process). For multi-process prod use Redis:
# CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
# CHANNEL_LAYER_HOSTS=redis://127.0.0.1:6379/0
KDS_ENABLED=True

# Stripe payments. Leave the secret key blank to run the simulated gateway.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
